# Public template - do not add real keys here. Copy to .env (which git ignores) and fill in.
# On the Space, set the same two as Space secrets instead.

# The demo key: gpt-oss-120b on Groq, for RAG answers (and Compact now) when a visitor has not pasted their own key.
# Visitors' own keys are typed into the page, never stored here. https://console.groq.com/keys
GROQ_API_KEY=

# Embeddings: gemini-embedding-001, for every question's search and for refreshing the index
# (python -m ask_the_cookbook.refresh). https://aistudio.google.com/apikey
# Do not also set GOOGLE_API_KEY anywhere on the machine: Google's library uses it instead of this one.
GEMINI_API_KEY=
